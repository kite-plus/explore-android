    <string name="about_crawler">About the Crawler</string>
    <string name="about_explore">About Explore</string>
    <string name="about_footer">Explore is the discovery side of Kite Plus.</string>
    <string name="about_point_author">A post opens at its original address, with no page in between. Explore adds only utm_source, so the author can tell the visit came from Explore; nothing in it identifies you.</string>
    <string name="about_point_author_title">Always read on the author\'s site</string>
    <string name="about_point_content">Explore keeps neither post content nor images. What you see is a cache of what each feed says right now; when an author edits or deletes a post, Explore follows.</string>
    <string name="about_point_content_title">No post content kept</string>
    <string name="about_point_leaving">Authors can leave at any time: answer Explore\'s crawler with 410 Gone, disallow KiteExplore in robots.txt, or open an issue.</string>
    <string name="about_point_leaving_title">Leaving is easy</string>
    <string name="about_point_listing">Authors submit their blog and its feed is checked on the spot. A maintainer reviews blogs that pass: personal and independent blogs, updated within the last 12 months.</string>
    <string name="about_point_listing_title">How blogs are listed</string>
    <string name="about_point_private">Reading needs no account and this app has no analytics. Thumbnails and icons come from Explore\'s own server, never from third parties. With an account, Explore keeps your email, your name, a hash of your password and the blogs you follow, and never what you read.</string>
    <string name="about_point_private_title">Private by design</string>
    <string name="about_point_stream">Explore gathers the public feeds of independent blogs and shows their latest posts, newest first. Any blog with RSS, Atom or JSON Feed can join.</string>
    <string name="about_point_stream_title">One stream of independent blogs</string>
